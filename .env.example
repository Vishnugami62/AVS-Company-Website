# Copy this file to ".env" and fill in real values before going live.

# --- Database ---
# Dev (SQLite, no setup needed):
DATABASE_URL="file:./dev.db"
# Production example (managed Postgres): change provider in prisma/schema.prisma
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/avs?sslmode=require"

# --- Session security ---
# Generate a long random string, e.g. in PowerShell:
#   [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Public base URL of the site (used in emails / tracking links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (optional in dev) ---
# Leave EMAIL_TRANSPORT=log in development: emails are written to the DB and
# console instead of being sent. Set to "smtp" and fill SMTP_* to send for real.
EMAIL_TRANSPORT="log"
EMAIL_FROM="AVS Company <orders@yourdomain.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Address that receives internal staff order alerts
TEAM_ALERT_EMAIL="orders@yourdomain.com"
