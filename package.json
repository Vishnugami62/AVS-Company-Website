{
  "name": "avs-company-website",
  "version": "1.0.0",
  "private": true,
  "description": "AVS Company — corporate supplies website with order tracking and staff admin",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
